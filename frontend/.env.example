# Local development: copy this value into .env.local (gitignored).
# Production (Vercel): set VITE_API_URL to your deployed API origin ending in /api.
# Do not use localhost or 127.0.0.1 in a production build.
VITE_API_URL=http://localhost:8081/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key
