PORT=8081
NODE_ENV=development
FRONTEND_URLS=http://localhost:5173,http://localhost:3000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key

# Used in Supabase Dashboard → Authentication → Providers → Google.
# Do not copy these into frontend or VITE_* variables.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Used in Supabase Dashboard → Authentication → Providers → GitHub.
# Do not copy these into frontend or VITE_* variables.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Contact form (backend only — never put this in VITE_* / frontend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=karank47417@gmail.com
CONTACT_TO_EMAIL=karank47417@gmail.com

# Hugging Face Inference Providers (backend only — never put this in VITE_* / frontend)
# Fine-grained HF_TOKEN must enable "Make calls to Inference Providers" (inference.serverless.write).
# repo.content.read alone is not enough and returns 403 from router.huggingface.co.
HF_TOKEN=hf_your_huggingface_token
# Optional model / provider routing (default provider: fastest)
# HUGGINGFACE_QUESTION_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HUGGINGFACE_INFERENCE_PROVIDER=fastest
# INTERVIEW_QUESTION_COUNT=5
# Gemini Live (backend only — never put this in VITE_* / frontend)
GEMINI_API_KEY=your_gemini_api_key
# Optional overrides (defaults: gemini-3.1-flash-live-preview + gemini-3.5-transcribe-live)
# GEMINI_INTERVIEWER_MODEL=gemini-3.1-flash-live-preview
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
# GEMINI_GRADE_MODEL=gemini-3.6-flash

# LiveKit Cloud (backend only — never put API key/secret in VITE_* / frontend)
# LIVEKIT_URL may be returned to the browser as the public WebSocket URL.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
