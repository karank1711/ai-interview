# Database Configuration
# MongoDB Atlas is not used. Application data is stored in Supabase PostgreSQL.

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Swagger/OpenAPI Configuration
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api
VITE_APP_NAME=InterviewIQ
VITE_APP_VERSION=1.0.0

# Production Configuration
NODE_ENV=production
REACT_APP_API_URL=https://api.yourdomain.com
